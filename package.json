{
  "name": "@voyant-travel/theme-sdk-workspace",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "verify": "pnpm check-types && pnpm lint && pnpm test && pnpm build && pnpm verify:example",
    "verify:example": "node scripts/verify-example.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm verify && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@changesets/cli": "^2.29.7",
    "@types/node": "^22.10.1",
    "turbo": "^2.9.6",
    "typescript": "5.9.2",
    "vitest": "^4.1.2"
  }
}
