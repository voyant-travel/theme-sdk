{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.voyant.travel/theme/v1alpha1/theme-manifest.schema.json",
  "title": "Voyant theme manifest v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "routes"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "description": { "type": "string" },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "pattern", "context"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "pattern": { "type": "string", "pattern": "^/" },
          "context": { "enum": ["home", "content", "notFound"] }
        }
      }
    },
    "settings": {
      "type": "array",
      "items": { "$ref": "theme-field.schema.json" },
      "default": []
    },
    "sections": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "fields"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "fields": {
            "type": "array",
            "items": { "$ref": "theme-field.schema.json" }
          }
        }
      }
    }
  }
}
