{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.voyant.travel/theme/v1alpha4/theme-fixtures.schema.json",
  "title": "Voyant theme fixtures v1alpha4",
  "type": "object",
  "additionalProperties": false,
  "required": ["home", "content", "notFound"],
  "properties": {
    "home": { "$ref": "theme-context.schema.json#/$defs/home" },
    "content": {
      "type": "array",
      "items": { "$ref": "theme-context.schema.json#/$defs/content" },
      "default": []
    },
    "notFound": { "$ref": "theme-context.schema.json#/$defs/notFound" },
    "tourIndex": { "$ref": "theme-context.schema.json#/$defs/tourIndex" },
    "tourDetail": {
      "type": "array",
      "items": { "$ref": "theme-context.schema.json#/$defs/tourDetail" },
      "default": []
    }
  }
}
