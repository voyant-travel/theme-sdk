{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.voyant.travel/theme/v1alpha4/theme-tour-fixtures.schema.json",
  "title": "Voyant tour selling fixture matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "fixtures"],
  "properties": {
    "version": { "const": "v1" },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/indexFixture" },
          { "$ref": "#/$defs/detailFixture" },
          { "$ref": "#/$defs/liveFixture" }
        ]
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "code", "message", "retryable"],
      "properties": {
        "kind": { "const": "error" },
        "code": {
          "enum": [
            "invalid_request",
            "not_found",
            "unavailable",
            "unpriced",
            "sold_out",
            "session_missing",
            "session_expired",
            "revision_conflict",
            "idempotency_conflict",
            "payment_failed",
            "provider_error"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" }
      }
    },
    "pageRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path"],
      "properties": {
        "method": { "const": "GET" },
        "path": { "type": "string", "pattern": "^/tours" }
      }
    },
    "pageError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "error"],
      "properties": {
        "status": { "type": "integer", "minimum": 400, "maximum": 599 },
        "error": { "$ref": "#/$defs/error" }
      }
    },
    "indexFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "surface", "state", "request", "response"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "surface": { "const": "index" },
        "state": { "enum": ["populated", "empty", "error"] },
        "request": { "$ref": "#/$defs/pageRequest" },
        "response": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "context"],
              "properties": {
                "status": { "const": 200 },
                "context": {
                  "$ref": "theme-context.schema.json#/$defs/tourIndex"
                }
              }
            },
            { "$ref": "#/$defs/pageError" }
          ]
        }
      }
    },
    "detailFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "surface", "state", "request", "response"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "surface": { "const": "detail" },
        "state": { "enum": ["rich", "minimal", "notFound", "unavailable"] },
        "request": { "$ref": "#/$defs/pageRequest" },
        "response": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "context"],
              "properties": {
                "status": { "const": 200 },
                "context": {
                  "$ref": "theme-context.schema.json#/$defs/tourDetail"
                }
              }
            },
            { "$ref": "#/$defs/pageError" }
          ]
        }
      }
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amountMinor", "currency"],
      "properties": {
        "amountMinor": { "type": "integer", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "offerId", "productId", "total", "expiresAt"],
      "properties": {
        "kind": { "const": "offer" },
        "offerId": { "type": "string", "minLength": 1 },
        "productId": { "type": "string", "minLength": 1 },
        "total": { "$ref": "#/$defs/money" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "productId", "options"],
      "properties": {
        "kind": { "const": "availability" },
        "productId": { "type": "string", "minLength": 1 },
        "options": {
          "type": "array",
          "items": { "$ref": "#/$defs/availabilityOption" }
        }
      }
    },
    "availabilityOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "startsAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "startsAt": { "type": "string", "format": "date-time" },
        "endsAt": { "type": "string", "format": "date-time" },
        "remaining": { "type": "integer", "minimum": 0 }
      }
    },
    "bookingSession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sessionId", "revision", "status", "expiresAt"],
      "properties": {
        "kind": { "const": "bookingSession" },
        "sessionId": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["draft", "held", "committed"] },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "checkout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "checkoutId", "status"],
      "properties": {
        "kind": { "const": "checkout" },
        "checkoutId": { "type": "string", "minLength": 1 },
        "status": {
          "enum": [
            "ready",
            "paymentPending",
            "paymentSucceeded",
            "paymentFailed"
          ]
        },
        "redirectUrl": { "type": "string", "format": "uri" }
      }
    },
    "httpBody": {
      "oneOf": [
        { "$ref": "#/$defs/offer" },
        { "$ref": "#/$defs/availability" },
        { "$ref": "#/$defs/bookingSession" },
        { "$ref": "#/$defs/checkout" },
        { "$ref": "#/$defs/error" }
      ]
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["transport", "status", "body"],
          "properties": {
            "transport": { "const": "http" },
            "status": { "type": "integer", "minimum": 100, "maximum": 599 },
            "body": { "$ref": "#/$defs/httpBody" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["transport", "code", "message"],
          "properties": {
            "transport": { "const": "networkError" },
            "code": {
              "enum": ["connection_refused", "connection_reset", "timeout"]
            },
            "message": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["transport", "status", "contentType", "rawBody"],
          "properties": {
            "transport": { "const": "malformed" },
            "status": { "type": "integer", "minimum": 200, "maximum": 599 },
            "contentType": { "type": "string", "minLength": 1 },
            "rawBody": { "type": "string" }
          }
        }
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path"],
      "properties": {
        "method": { "enum": ["GET", "POST", "PATCH"] },
        "path": { "type": "string", "pattern": "^/v1/public/" },
        "query": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "default": {}
        },
        "body": true
      }
    },
    "liveFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "surface", "state", "capability", "request", "result"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "surface": { "const": "live" },
        "state": {
          "enum": [
            "priced",
            "unpriced",
            "available",
            "soldOut",
            "invalid",
            "created",
            "held",
            "committed",
            "missing",
            "expired",
            "revisionConflict",
            "idempotencyConflict",
            "checkoutReady",
            "paymentPending",
            "paymentSucceeded",
            "paymentFailed",
            "providerError",
            "networkError",
            "malformed"
          ]
        },
        "capability": {
          "enum": [
            "catalog.search.v1",
            "catalog.product-detail.v1",
            "catalog.pricing.v1",
            "catalog.availability.v1",
            "catalog.requirements.v1",
            "catalog.markets.v1",
            "booking.session.v1",
            "checkout.v1"
          ]
        },
        "request": { "$ref": "#/$defs/request" },
        "result": { "$ref": "#/$defs/result" }
      }
    }
  }
}
