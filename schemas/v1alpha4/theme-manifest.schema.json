{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.voyant.travel/theme/v1alpha4/theme-manifest.schema.json",
  "title": "Voyant theme manifest v1alpha4",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "routes"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "description": { "type": "string" },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "pattern", "context"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "pattern": { "type": "string", "pattern": "^/" },
          "context": {
            "enum": [
              "home",
              "content",
              "notFound",
              "collectionIndex",
              "collectionEntry",
              "tourIndex",
              "tourDetail"
            ]
          }
        }
      }
    },
    "settings": { "type": "array", "default": [] },
    "sections": { "type": "array", "default": [] },
    "contentBindings": { "type": "array", "maxItems": 20, "default": [] },
    "capabilities": {
      "type": "array",
      "maxItems": 8,
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": {
            "enum": [
              "catalog.search.v1",
              "catalog.product-detail.v1",
              "catalog.pricing.v1",
              "catalog.availability.v1",
              "catalog.requirements.v1",
              "catalog.markets.v1",
              "booking.session.v1",
              "checkout.v1"
            ]
          },
          "required": { "type": "boolean", "default": true }
        }
      }
    }
  }
}
