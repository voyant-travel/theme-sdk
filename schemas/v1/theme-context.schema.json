{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.voyant.travel/theme/v1/theme-context.schema.json",
  "title": "Voyant page context v1",
  "description": "Published contexts are open for additive fields. Immutable cruise graphs recursively reject commercial, privacy, provider, source, and provenance fields; live values use capabilities.",
  "oneOf": [
    { "$ref": "../v1alpha4/theme-context.schema.json#/$defs/home" },
    { "$ref": "../v1alpha4/theme-context.schema.json#/$defs/content" },
    { "$ref": "../v1alpha4/theme-context.schema.json#/$defs/notFound" },
    { "$ref": "../v1alpha4/theme-context.schema.json#/$defs/collectionIndex" },
    { "$ref": "../v1alpha4/theme-context.schema.json#/$defs/collectionEntry" },
    { "$ref": "../v1alpha4/theme-context.schema.json#/$defs/tourIndex" },
    { "$ref": "../v1alpha4/theme-context.schema.json#/$defs/tourDetail" },
    { "$ref": "#/$defs/categoryDetail" },
    { "$ref": "#/$defs/cruiseIndex" },
    { "$ref": "#/$defs/cruiseDetail" },
    { "$ref": "#/$defs/shipDetail" },
    { "$ref": "#/$defs/sailingDetail" }
  ],
  "$defs": {
    "home": { "$ref": "../v1alpha4/theme-context.schema.json#/$defs/home" },
    "content": {
      "$ref": "../v1alpha4/theme-context.schema.json#/$defs/content"
    },
    "notFound": {
      "$ref": "../v1alpha4/theme-context.schema.json#/$defs/notFound"
    },
    "tourIndex": {
      "$ref": "../v1alpha4/theme-context.schema.json#/$defs/tourIndex"
    },
    "tourDetail": {
      "$ref": "../v1alpha4/theme-context.schema.json#/$defs/tourDetail"
    },
    "categoryDetail": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["kind", "path", "slug", "title", "category"],
          "properties": {
            "kind": { "const": "categoryDetail" },
            "path": { "type": "string", "pattern": "^/" },
            "slug": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 },
            "category": {
              "$ref": "../v1alpha4/theme-context.schema.json#/$defs/category"
            },
            "products": {
              "type": "array",
              "default": [],
              "items": {
                "$ref": "../v1alpha4/theme-context.schema.json#/$defs/catalogProduct"
              }
            }
          }
        }
      ]
    },
    "base": {
      "type": "object",
      "required": ["kind", "path", "locale", "site", "seo"],
      "properties": {
        "locale": { "type": "string", "minLength": 2 },
        "templateId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "site": {
          "type": "object",
          "required": ["name"],
          "properties": { "name": { "type": "string", "minLength": 1 } }
        },
        "seo": {
          "type": "object",
          "required": ["title"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "description": { "type": "string" },
            "noIndex": { "type": "boolean", "default": false }
          }
        },
        "menus": { "type": "object", "default": {} },
        "navigation": { "type": "array", "default": [] },
        "settings": { "type": "object", "default": {} },
        "live": { "$ref": "#/$defs/live" },
        "alternates": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": ["locale", "path"],
            "properties": {
              "locale": { "type": "string", "minLength": 2 },
              "path": { "type": "string", "pattern": "^/" }
            }
          }
        }
      }
    },
    "publicationSafe": {
      "propertyNames": {
        "not": {
          "pattern": "(?:[Pp]rice|[Pp]ricing|[Aa]mount|[Cc]urrency|[Ff]are|[Pp]romotion|[Pp]romo|[Dd]iscount|[Aa]vailability|[Ii]nventory|[Qq]uote|[Bb]ooking|[Cc]heckout|[Ss]ession|[Pp]ayment|[Bb]illing|[Cc]ard|[Cc]ustomer|[Pp]assenger|[Tt]ravell?er|[Ee]mail|[Pp]hone|[Dd]ateOfBirth|[Bb]irthDate|[Dd]ob|[Ff]irstName|[Ll]astName|[Ff]ullName|[Cc]ontact|[Pp]ostalCode|[Ii]pAddress|[Pp]assport|[Aa]ddress|[Tt]oken|[Ss]ecret|[Cc]redential|[Pp]rovider|[Ss]upplier|^source|Source|[Pp]rovenance|[Rr]awPayload)"
        }
      },
      "additionalProperties": { "$ref": "#/$defs/publicationSafe" },
      "items": { "$ref": "#/$defs/publicationSafe" }
    },
    "capabilityId": {
      "enum": [
        "catalog.search.v1",
        "catalog.product-detail.v1",
        "catalog.pricing.v1",
        "catalog.availability.v1",
        "catalog.requirements.v1",
        "catalog.markets.v1",
        "catalog.categories.v1",
        "catalog.destinations.v1",
        "catalog.tags.v1",
        "catalog.product-by-slug.v1",
        "catalog.departures.v1",
        "catalog.departure-pricing.v1",
        "catalog.offers.v1",
        "catalog.extensions.v1",
        "operator.profile.v1",
        "operator.settings.v1",
        "legal.policy.v1",
        "legal.terms.v1",
        "cruise.search.v1",
        "cruise.sailing.v1",
        "cruise.pricing.v1",
        "cruise.quote.v1",
        "shopping.search.v1",
        "shopping.trip-selections.v1",
        "shopping.trip-booking.v1",
        "booking.session.v1",
        "checkout.v1"
      ]
    },
    "live": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "available", "methods"],
            "properties": {
              "id": { "$ref": "#/$defs/capabilityId" },
              "available": { "type": "boolean" },
              "methods": {
                "type": "array",
                "minItems": 1,
                "items": { "enum": ["GET", "POST", "PATCH"] }
              },
              "endpoint": { "type": "string", "pattern": "^/v1/public/[^?#]+$" }
            },
            "allOf": [
              {
                "if": { "properties": { "available": { "const": true } } },
                "then": { "required": ["endpoint"] },
                "else": { "not": { "required": ["endpoint"] } }
              },
              {
                "if": {
                  "properties": {
                    "id": {
                      "enum": [
                        "catalog.search.v1",
                        "catalog.product-detail.v1",
                        "catalog.markets.v1",
                        "catalog.categories.v1",
                        "catalog.destinations.v1",
                        "catalog.tags.v1",
                        "catalog.product-by-slug.v1",
                        "catalog.departures.v1",
                        "catalog.offers.v1",
                        "catalog.extensions.v1",
                        "operator.profile.v1",
                        "operator.settings.v1",
                        "legal.policy.v1",
                        "legal.terms.v1",
                        "cruise.search.v1",
                        "cruise.sailing.v1"
                      ]
                    }
                  }
                },
                "then": { "properties": { "methods": { "const": ["GET"] } } }
              },
              {
                "if": {
                  "properties": {
                    "id": {
                      "enum": [
                        "catalog.pricing.v1",
                        "catalog.availability.v1",
                        "catalog.requirements.v1",
                        "catalog.departure-pricing.v1",
                        "cruise.pricing.v1",
                        "cruise.quote.v1",
                        "shopping.search.v1",
                        "shopping.trip-booking.v1",
                        "checkout.v1"
                      ]
                    }
                  }
                },
                "then": { "properties": { "methods": { "const": ["POST"] } } }
              },
              {
                "if": {
                  "properties": {
                    "id": { "const": "shopping.trip-selections.v1" }
                  }
                },
                "then": {
                  "properties": { "methods": { "const": ["POST", "PATCH"] } }
                }
              },
              {
                "if": {
                  "properties": { "id": { "const": "booking.session.v1" } }
                },
                "then": {
                  "properties": { "methods": { "const": ["POST", "PATCH"] } }
                }
              }
            ]
          }
        }
      }
    },
    "media": {
      "type": "object",
      "required": ["id", "mediaType", "name", "url"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "mediaType": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "mimeType": { "type": ["string", "null"] },
        "width": { "type": ["integer", "null"], "exclusiveMinimum": 0 },
        "height": { "type": ["integer", "null"], "exclusiveMinimum": 0 },
        "altText": { "type": ["string", "null"] },
        "sortOrder": { "type": "integer" }
      }
    },
    "coverMedia": {
      "oneOf": [{ "$ref": "#/$defs/media" }, { "type": "null" }]
    },
    "port": {
      "allOf": [
        { "$ref": "#/$defs/publicationSafe" },
        {
          "type": "object",
          "required": ["id", "slug", "name"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "slug": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "countryCode": { "type": "string", "minLength": 2, "maxLength": 2 },
            "descriptionHtml": { "type": "string" },
            "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
            "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
            "coverMedia": { "$ref": "#/$defs/coverMedia" },
            "media": {
              "type": "array",
              "items": { "$ref": "#/$defs/media" },
              "default": []
            }
          }
        }
      ]
    },
    "cabinCategory": {
      "allOf": [
        { "$ref": "#/$defs/publicationSafe" },
        {
          "type": "object",
          "required": ["id", "slug", "name"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "slug": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "descriptionHtml": { "type": "string" },
            "maxOccupancy": { "type": "integer", "exclusiveMinimum": 0 },
            "deckNames": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "default": []
            },
            "coverMedia": { "$ref": "#/$defs/coverMedia" },
            "media": {
              "type": "array",
              "items": { "$ref": "#/$defs/media" },
              "default": []
            }
          }
        }
      ]
    },
    "ship": {
      "allOf": [
        { "$ref": "#/$defs/publicationSafe" },
        {
          "type": "object",
          "required": ["id", "slug", "name"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "slug": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "descriptionHtml": { "type": "string" },
            "cruiseLine": { "type": "string", "minLength": 1 },
            "launchedYear": { "type": "integer", "exclusiveMinimum": 0 },
            "deckCount": { "type": "integer", "exclusiveMinimum": 0 },
            "coverMedia": { "$ref": "#/$defs/coverMedia" },
            "media": {
              "type": "array",
              "items": { "$ref": "#/$defs/media" },
              "default": []
            },
            "cabinCategories": {
              "type": "array",
              "items": { "$ref": "#/$defs/cabinCategory" },
              "default": []
            }
          }
        }
      ]
    },
    "itinerary": {
      "allOf": [
        { "$ref": "#/$defs/publicationSafe" },
        {
          "type": "object",
          "required": ["id", "name", "days"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "days": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["dayNumber", "title"],
                "properties": {
                  "dayNumber": { "type": "integer", "exclusiveMinimum": 0 },
                  "title": { "type": "string", "minLength": 1 },
                  "descriptionHtml": { "type": "string" },
                  "coverMedia": { "$ref": "#/$defs/coverMedia" },
                  "ports": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/port" },
                    "default": []
                  },
                  "atSea": { "type": "boolean", "default": false }
                }
              }
            }
          }
        }
      ]
    },
    "departure": {
      "allOf": [
        { "$ref": "#/$defs/publicationSafe" },
        {
          "type": "object",
          "required": [
            "startsOn",
            "endsOn",
            "durationNights",
            "embarkationPort",
            "disembarkationPort"
          ],
          "properties": {
            "startsOn": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "endsOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "durationNights": { "type": "integer", "minimum": 0 },
            "embarkationPort": { "$ref": "#/$defs/port" },
            "disembarkationPort": { "$ref": "#/$defs/port" }
          }
        }
      ]
    },
    "sailing": {
      "allOf": [
        { "$ref": "#/$defs/publicationSafe" },
        {
          "type": "object",
          "required": [
            "id",
            "slug",
            "name",
            "cruiseId",
            "shipId",
            "departure",
            "itinerary"
          ],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "slug": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "cruiseId": { "type": "string", "minLength": 1 },
            "shipId": { "type": "string", "minLength": 1 },
            "departure": { "$ref": "#/$defs/departure" },
            "itinerary": { "$ref": "#/$defs/itinerary" },
            "coverMedia": { "$ref": "#/$defs/coverMedia" },
            "media": {
              "type": "array",
              "items": { "$ref": "#/$defs/media" },
              "default": []
            },
            "cabinCategories": {
              "type": "array",
              "items": { "$ref": "#/$defs/cabinCategory" },
              "default": []
            }
          }
        }
      ]
    },
    "cruise": {
      "allOf": [
        { "$ref": "#/$defs/publicationSafe" },
        {
          "type": "object",
          "required": ["id", "slug", "name"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "slug": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "shortDescription": { "type": "string" },
            "descriptionHtml": { "type": "string" },
            "coverMedia": { "$ref": "#/$defs/coverMedia" },
            "media": {
              "type": "array",
              "items": { "$ref": "#/$defs/media" },
              "default": []
            },
            "ports": {
              "type": "array",
              "items": { "$ref": "#/$defs/port" },
              "default": []
            },
            "ships": {
              "type": "array",
              "items": { "$ref": "#/$defs/ship" },
              "default": []
            },
            "sailings": {
              "type": "array",
              "items": { "$ref": "#/$defs/sailing" },
              "default": []
            }
          }
        }
      ]
    },
    "cruiseIndex": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "$ref": "#/$defs/publicationSafe" },
        {
          "required": ["title", "cruises"],
          "properties": {
            "kind": { "const": "cruiseIndex" },
            "path": { "const": "/cruises" },
            "title": { "type": "string", "minLength": 1 },
            "cruises": {
              "type": "array",
              "items": { "$ref": "#/$defs/cruise" },
              "default": []
            }
          }
        }
      ]
    },
    "cruiseDetail": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "$ref": "#/$defs/publicationSafe" },
        {
          "required": ["slug", "title", "cruise"],
          "properties": {
            "kind": { "const": "cruiseDetail" },
            "path": { "type": "string", "pattern": "^/cruises/[^/]+$" },
            "slug": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 },
            "cruise": { "$ref": "#/$defs/cruise" }
          }
        }
      ]
    },
    "shipDetail": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "$ref": "#/$defs/publicationSafe" },
        {
          "required": ["slug", "title", "ship"],
          "properties": {
            "kind": { "const": "shipDetail" },
            "path": { "type": "string", "pattern": "^/ships/[^/]+$" },
            "slug": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 },
            "ship": { "$ref": "#/$defs/ship" }
          }
        }
      ]
    },
    "sailingDetail": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "$ref": "#/$defs/publicationSafe" },
        {
          "required": ["slug", "title", "sailing"],
          "properties": {
            "kind": { "const": "sailingDetail" },
            "path": { "type": "string", "pattern": "^/sailings/[^/]+$" },
            "slug": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 },
            "sailing": { "$ref": "#/$defs/sailing" }
          }
        }
      ]
    }
  }
}
