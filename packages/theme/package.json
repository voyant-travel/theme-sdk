{
  "name": "@voyant-travel/theme",
  "version": "1.6.0",
  "description": "The public contract and local tooling for Astro Themes for Voyant Sites.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voyant-travel/theme-sdk.git",
    "directory": "packages/theme"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tooling": "./src/tooling.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "jiti": "^2.6.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "5.9.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./tooling": {
        "types": "./dist/tooling.d.ts",
        "import": "./dist/tooling.js",
        "default": "./dist/tooling.js"
      }
    }
  }
}
