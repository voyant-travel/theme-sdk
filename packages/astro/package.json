{
  "name": "@voyant-travel/astro",
  "version": "1.8.0-canary.0",
  "description": "Astro and Cloudflare runtime integration for Voyant themes.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voyant-travel/theme-sdk.git",
    "directory": "packages/astro"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./middleware": "./src/middleware.ts",
    "./system-middleware": "./src/system-middleware.ts",
    "./runtime": "./src/runtime.ts",
    "./virtual": "./src/virtual.d.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/virtual.d.ts dist/virtual.d.ts",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@voyant-travel/theme": "workspace:^"
  },
  "peerDependencies": {
    "astro": ">=7.0.0 <8.0.0"
  },
  "devDependencies": {
    "astro": "7.1.6",
    "typescript": "5.9.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./middleware": {
        "types": "./dist/middleware.d.ts",
        "import": "./dist/middleware.js",
        "default": "./dist/middleware.js"
      },
      "./system-middleware": {
        "types": "./dist/system-middleware.d.ts",
        "import": "./dist/system-middleware.js",
        "default": "./dist/system-middleware.js"
      },
      "./runtime": {
        "types": "./dist/runtime.d.ts",
        "import": "./dist/runtime.js",
        "default": "./dist/runtime.js"
      },
      "./virtual": {
        "types": "./dist/virtual.d.ts"
      }
    }
  }
}
