---
import { resolveThemeContext } from "virtual:voyant-theme";

const context = await resolveThemeContext(Astro.url);
if (context.kind === "notFound") Astro.response.status = 404;
---

<!doctype html>
<html lang={context.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{context.seo.title} · {context.site.name}</title>
    {context.seo.description && <meta name="description" content={context.seo.description} />}
    {context.seo.noIndex && <meta name="robots" content="noindex" />}
    {context.openGraph?.title && <meta property="og:title" content={context.openGraph.title} />}
    {context.openGraph?.description && <meta property="og:description" content={context.openGraph.description} />}
    {context.openGraph?.image && <meta property="og:image" content={context.openGraph.image.src} />}
    {/* Operator markup arrives sanitized and bounded. Placing it is the theme's
        job; escaping it here would defeat the analytics and consent tags it
        exists for. */}
    {context.codeInjection?.head && <Fragment set:html={context.codeInjection.head} />}
  </head>
  <body>
    {context.codeInjection?.bodyStart && <Fragment set:html={context.codeInjection.bodyStart} />}
    <header>
      <a href="/">{context.site.name}</a>
      <nav>{context.navigation.map((item) => <a href={item.href}>{item.label}</a>)}</nav>
    </header>
    <main>
      <p>{context.kind}</p>
      <h1>{context.title}</h1>
      {context.kind === "content" && <><p>{context.summary}</p><article>{context.body}</article></>}
      {context.kind === "home" && context.sections.map((section) => <section data-type={section.type}>{String(section.data.eyebrow ?? "")}</section>)}
      {context.kind === "notFound" && <p>{context.message}</p>}
    </main>
    <footer>
      <nav>{(context.menus.footer ?? []).map((item) => <a href={item.href}>{item.label}</a>)}</nav>
    </footer>
    {context.codeInjection?.bodyEnd && <Fragment set:html={context.codeInjection.bodyEnd} />}
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { max-width: 70rem; margin: auto; padding: 2rem; font: 1rem/1.6 system-ui; color: #16343b; }
  header { display: flex; justify-content: space-between; gap: 2rem; }
  nav { display: flex; gap: 1rem; }
  main { padding-block: 12vh; }
  h1 { max-width: 14ch; font-size: clamp(2.5rem, 8vw, 6rem); line-height: .95; }
</style>
